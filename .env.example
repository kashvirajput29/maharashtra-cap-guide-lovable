# Copy this file to .env and fill in your local keys (never commit your actual .env file)

# Application URL
VITE_APP_URL=http://localhost:5173

# AI Assistant / LLM API Configuration (if running AI recommendation endpoints locally)
VITE_AI_API_KEY=your_api_key_here

# Database / Backend Endpoint (if connected to external cutoff storage)
VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here
